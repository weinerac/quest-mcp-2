{
  "name": "quest-apartment-hotels-mcp",
  "version": "1.0.0",
  "description": "MCP server and app for Quest Apartment Hotels with location-based search",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"cross-env NODE_ENV=development vite build --watch\" \"tsx --watch main.ts\"",
    "serve": "tsx main.ts",
    "build-app": "vite build",
    "preview": "node dist/main.js"
  },
  "keywords": ["mcp", "quest", "hotels", "apartment", "travel"],
  "author": "Alex Weiner",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.2.3",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0"
  }
}
